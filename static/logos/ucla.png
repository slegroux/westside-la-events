<!-- Include the YouTube Iframe API -->
<!-- Include the YouTube Iframe API -->
<script>
  // 2. This code loads the IFrame Player API code asynchronously.
  var tag = document.createElement('script');
  tag.src = "https://www.youtube.com/iframe_api";
  var firstScriptTag = document.getElementsByTagName('script')[0];
  firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

  // This array will store all the YouTube players
  var players = [];

  // This function will be called after the API code downloads.
  function onYouTubeIframeAPIReady() {
    // Get all elements with class "youtube-player"
    var youtubePlayers = document.querySelectorAll('.youtube-player');

    youtubePlayers.forEach(function(playerElement, index) {
      // Get the YouTube URL from data attribute
      var youtubeUrl = playerElement.getAttribute('youtube_url');
      var videoId = getYouTubeVideoId(youtubeUrl);

      //add id to the element
      playerElement.setAttribute('id','youtube_player_id_' + index );

      // Create a unique ID for each player
      var playerId = 'youtube_player_id_' + index;

      // Create a new player and store it in the players array
      var player = new YT.Player(playerId, {
        height: '500',
        width: '802',
        videoId: videoId,
        events: {
          'onReady': onPlayerReady
        }
      });

      players.push(player);

      // Set a click event for the play button
      var playButton = document.getElementById(playerId).nextElementSibling;
      playButton.addEventListener('click', function() {
        playVideo(index);

        //hide the play buton
        this .style.display = 'none'
      });
    });
  }

  function playVideo(index) {
    // Play the video for the specified index
    players[index].playVideo();
  }

  function getYouTubeVideoId(url) {
    // Define the regular expression pattern for matching YouTube URLs
    var pattern = /^(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:[^\/\n\s]+\/\S+\/|(?:v|e(?:mbed)?)\/|\S*?[?&]v=)|youtu\.be\/)([a-zA-Z0-9_-]{11})/;

    // Use the pattern to match and extract the video ID
    var match = url.match(pattern);

    // Check if there is a match and return the video ID
    return match ? match[1] : null;
  }

  function onPlayerReady(event) {
    // You can do additional setup here if needed
  }
</script>

