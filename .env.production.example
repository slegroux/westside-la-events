# Production Environment Variables
# Copy this file to .env.production and fill in your values
# Usage: ./scripts/deploy.sh --env-file .env.production

# Google Geocoding API Key (optional, for geocoding)
# GOOGLE_GEOCODING_API_KEY=your_api_key_here

# Database configuration (optional, defaults to Cloud Storage)
# DATABASE_PATH=/app/data/events.db
# ANALYTICS_DATABASE_PATH=/app/data/analytics.db

# Scraper configuration
# SCRAPER_TIMEOUT=30
# SCRAPER_MAX_RETRIES=3

# Feature flags
# ENABLE_ANALYTICS=true
# ENABLE_FAVORITES=true

# Admin analytics authentication (required for /admin/analytics)
# ENABLE_ADMIN_AUTH=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=strong-random-password

# Logging
# LOG_LEVEL=INFO
