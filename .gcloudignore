# This file tells gcloud which files to ignore when uploading to Cloud Build
# Similar to .dockerignore but specifically for gcloud builds submit

# This file
.gcloudignore
.git
.gitignore
.github

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Environments
.env
.envrc
venv/
env/
ENV/
.micromamba/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation
*.md
!README.md
docs/

# Testing
tests/
*.log
logs/

# Data - runtime state only. Both services mount the bucket over /app/data,
# which hides anything baked in. Anchored with a leading slash: gitignore
# syntax would otherwise also match src/data/, the app's database code.
/data/

# DVC cache (~170 MB) and local tool state
.dvc/
.omc/

# Review screenshots in the repo root
/*.png

# Scripts (not needed in container)
scripts/

# Large downloads
google-cloud-cli-linux-x86_64.tar.gz
google-cloud-sdk/

# Claude
.claude/

# Backup files
*.bak
*.backup
*.tmp
