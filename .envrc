# Automatically activate micromamba 'la' environment
# This file is used by direnv to set up the environment

# Activate micromamba 'la' environment
layout_micromamba() {
    local env_name="${1:-la}"
    local mamba_root="${MAMBA_ROOT_PREFIX:-$HOME/micromamba}"
    local env_path="${mamba_root}/envs/${env_name}"

    if [ ! -d "$env_path" ]; then
        log_error "Micromamba environment '$env_name' not found at $env_path"
        return 1
    fi

    # Set environment variables
    export CONDA_DEFAULT_ENV="$env_name"
    export CONDA_PREFIX="$env_path"
    export CONDA_SHLVL=1
    export MAMBA_ROOT_PREFIX="$mamba_root"

    # Add bin directory to PATH
    PATH_add "$env_path/bin"

    log_status "Activated micromamba environment: $env_name"
}

# Activate the 'la' environment
layout_micromamba la

# Load .env file if it exists (for API keys)
dotenv_if_exists
