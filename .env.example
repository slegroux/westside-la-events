# Google Maps API Keys
# Get your API keys from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key_here
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here

# Event Platform API Keys (Optional - uncomment and add keys if you want to use APIs)
# Currently the project uses web scraping only, which requires no API keys!
#
# Eventbrite: https://www.eventbrite.com/platform/api
# EVENTBRITE_API_TOKEN=your_eventbrite_api_token_here
#
# Meetup: https://www.meetup.com/api/
# MEETUP_API_KEY=your_meetup_api_key_here
#
# Facebook (very restricted): https://developers.facebook.com/
# FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here

# Database Configuration
DATABASE_PATH=data/events.db

# Scraper Configuration
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; LAEventsBot/1.0)
SCRAPER_DELAY_SECONDS=1
SCRAPER_TIMEOUT_SECONDS=30

# Scheduler Configuration (cron format)
# Default: Run daily at 3 AM
SCRAPER_SCHEDULE=0 3 * * *

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Web Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
