# LA Events Aggregator - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_PATH=data/events.db

# Google APIs (Optional - for geocoding and maps)
# Get your API keys from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Event Platform APIs (Optional - currently using web scraping)
# Eventbrite: https://www.eventbrite.com/platform/api
EVENTBRITE_API_TOKEN=
# Meetup: https://www.meetup.com/api/
MEETUP_API_KEY=
# Facebook (very restricted): https://developers.facebook.com/
FACEBOOK_ACCESS_TOKEN=

# Scraper Configuration
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; LAEventsBot/1.0)
SCRAPER_DELAY_SECONDS=1
SCRAPER_TIMEOUT_SECONDS=30

# Scheduler Configuration (cron format)
# Default: Run daily at 3 AM
SCRAPER_SCHEDULE=0 3 * * *

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Web Server Configuration
# Railway will automatically set PORT - leave empty for deployment
HOST=0.0.0.0
PORT=8000
DEBUG=False
